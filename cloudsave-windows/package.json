{
  "name": "cloudsave-windows",
  "version": "1.2.37",
  "description": "云存助手：资源浏览、磁力采集与网盘保存监控 Windows 桌面客户端",
  "main": "main.js",
  "author": "CloudSave",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable",
    "test": "node tests/run-tests.cjs"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.lite115.cloudsave.windows",
    "productName": "云存助手",
    "asar": true,
    "win": {
      "target": "portable",
      "artifactName": "CloudSave-Windows-${version}.exe"
    },
    "compression": "maximum",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
